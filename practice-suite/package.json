{
  "name": "playwright-practice-suite",
  "version": "1.0.0",
  "description": "Playwright practice suite against public QA demo sandboxes",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:drag": "playwright test tests/drag-and-drop",
    "test:upload": "playwright test tests/file-upload",
    "test:alerts": "playwright test tests/alerts",
    "test:clipboard": "playwright test tests/copy-paste",
    "test:windows": "playwright test tests/tab-window-switch",
    "test:scroll-h": "playwright test tests/scroll-horizontal",
    "test:scroll-v": "playwright test tests/scroll-vertical",
    "test:tables": "playwright test tests/table-and-sorting",
    "test:frames": "playwright test tests/frame-switch",
    "report": "playwright show-report",
    "test:bank-demo": "playwright test --project=bank-demo --project=setup --project=bank-demo-authed",
    "test:external": "playwright test --project=chromium-external",
    "test:smoke": "playwright test --project=bank-demo --project=setup --project=bank-demo-authed --grep @smoke",
    "test:a11y": "playwright test --project=bank-demo --grep @a11y",
    "test:visual": "playwright test --project=bank-demo --grep @visual",
    "typecheck": "tsc --noEmit",
    "lint": "eslint -c ../eslint.config.mjs .",
    "exercise": "playwright test -c exercises/playwright.config.ts",
    "exercise:interviewer": "playwright test -c exercises/interviewer/playwright.config.ts",
    "exercise:skills": "playwright test -c exercises/skills/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.13.10",
    "serve": "^14.2.4",
    "typescript": "^5.8.2"
  }
}
